.include "m328pdef.inc"

.def temp   = r16
.def dato   = r17
.def conta  = r18
.def figura = r19

; Pines de la matriz
.equ DIN = PB3
.equ CS  = PB2
.equ CLK = PB5

.org 0x0000
    rjmp RESET


RESET:

    ; Configuro el Stack
    ldi temp, HIGH(RAMEND)
    out SPH, temp

    ldi temp, LOW(RAMEND)
    out SPL, temp


    ; PB2, PB3 y PB5 son para la matriz
    ; PB0 y PB1 son los botones
    ldi temp, 0b00101100
    out DDRB, temp

    ; Pull-up de los dos botones
    ldi temp, 0b00000011
    out PORTB, temp

    ; Empiezo con el asterisco
    ldi figura, 0

    ; Configuro la matriz
    rcall INICIAR_MATRIZ


MAIN:

    ; Boton 1 = asterisco
    sbis PINB, PB0
    rjmp ELEGIR_ASTERISCO

    ; Boton 2 = XD
    sbis PINB, PB1
    rjmp ELEGIR_XD

    rjmp MAIN


ELEGIR_ASTERISCO:

    ldi figura, 0
    rcall MOSTRAR_ASTERISCO

ESPERAR_BOTON1:
    sbis PINB, PB0
    rjmp ESPERAR_BOTON1

    rjmp MAIN


ELEGIR_XD:

    ldi figura, 1
    rcall MOSTRAR_XD

ESPERAR_BOTON2:
    sbis PINB, PB1
    rjmp ESPERAR_BOTON2

    rjmp MAIN


; -------------------------
; Configuro el MAX7219
; -------------------------

INICIAR_MATRIZ:

    ; Salir del modo apagado
    ldi temp, 0x0C
    ldi dato, 0x01
    rcall ENVIAR_MAX

    ; Intensidad
    ldi temp, 0x0A
    ldi dato, 0x08
    rcall ENVIAR_MAX

    ; Uso las 8 filas
    ldi temp, 0x0B
    ldi dato, 0x07
    rcall ENVIAR_MAX

    ; Sin decodificacion
    ldi temp, 0x09
    ldi dato, 0x00
    rcall ENVIAR_MAX

    ; Test apagado
    ldi temp, 0x0F
    ldi dato, 0x00
    rcall ENVIAR_MAX

    ; Muestro el asterisco al empezar
    rcall MOSTRAR_ASTERISCO

    ret


; -------------------------
; Muestro el asterisco
; -------------------------

MOSTRAR_ASTERISCO:

    ldi ZH, HIGH(ASTERISCO*2)
    ldi ZL, LOW(ASTERISCO*2)

    ldi conta, 1


BUCLE_ASTERISCO:

    lpm dato, Z+

    mov temp, conta
    rcall ENVIAR_MAX

    inc conta
    cpi conta, 9
    brlo BUCLE_ASTERISCO

    ret


; -------------------------
; Muestro XD
; -------------------------

MOSTRAR_XD:

    ldi ZH, HIGH(XD*2)
    ldi ZL, LOW(XD*2)

    ldi conta, 1


BUCLE_XD:

    lpm dato, Z+

    mov temp, conta
    rcall ENVIAR_MAX

    inc conta
    cpi conta, 9
    brlo BUCLE_XD

    ret


; -------------------------
; Mando un dato a la matriz
; temp = direccion
; dato = valor
; -------------------------

ENVIAR_MAX:

    cbi PORTB, CS

    ; Primero mando la direccion
    push dato
    mov dato, temp
    rcall ENVIAR_BYTE
    pop dato

    ; Despues mando el dato
    rcall ENVIAR_BYTE

    ; Termino el envio
    sbi PORTB, CS
    ret


; -------------------------
; Mando los 8 bits
; -------------------------

ENVIAR_BYTE:

    push temp
    ldi temp, 8


BIT_LOOP:

    ; CLK en 0
    cbi PORTB, CLK

    ; Miro el bit de la izquierda
    sbrc dato, 7
    sbi PORTB, DIN

    sbrs dato, 7
    cbi PORTB, DIN

    ; CLK en 1
    sbi PORTB, CLK

    ; Paso al siguiente bit
    lsl dato

    dec temp
    brne BIT_LOOP

    pop temp
    ret


; -------------------------
; Dibujo del asterisco
; -------------------------

ASTERISCO:

    .db 0b00011000, 0b01011010
    .db 0b00111100, 0b11111111
    .db 0b00111100, 0b01011010
    .db 0b00011000, 0b00000000


; -------------------------
; Dibujo XD
; -------------------------

XD:

    .db 0b10101110, 0b10101001
    .db 0b01001001, 0b01001001
    .db 0b01001001, 0b10101001
    .db 0b10101110, 0b00000000
